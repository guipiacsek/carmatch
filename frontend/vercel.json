{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-w4cunFTHidLg7wTnAluhMD+QJaSUuNBNODew9J2t620='; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://thumb.wikimedia.org https://upload.wikimedia.org; font-src 'self'; connect-src 'self' https://carmatch-api-tygz.onrender.com https://erzaewbunsjtiymldqgy.supabase.co wss://erzaewbunsjtiymldqgy.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "redirects": [
    {
      "source": "/best/used-suvs-under-25000",
      "destination": "/best/used-suvs-under-30000",
      "permanent": true
    },
    {
      "source": "/best/used-sedans-under-20000",
      "destination": "/best/new-sedans-under-30000",
      "permanent": true
    },
    {
      "source": "/best/used-trucks-under-35000",
      "destination": "/best/new-trucks-under-50000",
      "permanent": true
    },
    {
      "source": "/best/used-hybrids-under-25000",
      "destination": "/best/hybrids-under-35000",
      "permanent": true
    },
    {
      "source": "/best/3-row-suvs-under-45000",
      "destination": "/best/3-row-suvs-under-50000",
      "permanent": true
    },
    {
      "source": "/best/minivans",
      "destination": "/best/3-row-suvs-under-50000",
      "permanent": true
    },
    {
      "source": "/best/first-cars-under-15000",
      "destination": "/best/first-cars-under-20000",
      "permanent": true
    },
    {
      "source": "/best/awd-suvs-under-30000",
      "destination": "/best/used-suvs-under-30000",
      "permanent": true
    },
    {
      "source": "/best/sports-cars-under-40000",
      "destination": "/best/sports-cars-under-50000",
      "permanent": true
    },
    {
      "source": "/best/luxury-suvs-under-60000",
      "destination": "/best/luxury-suvs-under-70000",
      "permanent": true
    }
  ]
}
