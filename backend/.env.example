# OpenAI (leave empty locally to use the data-only mock ranking)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Supabase (Project Settings > API). Leave empty locally to use the in-memory cache and rate limiter.
SUPABASE_URL=
# Not used by the backend (the frontend uses VITE_SUPABASE_ANON_KEY); kept so both apps share one env list.
SUPABASE_ANON_KEY=
# Service role (legacy JWT) or the new sb_secret_... key. Server-side only, never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Only needed for projects still on the legacy HS256 JWT secret; new projects are verified via JWKS.
SUPABASE_JWT_SECRET=

# Comma-separated list of exact frontend origins
ALLOWED_ORIGINS=http://localhost:5173
# Optional: regex for Vercel preview deploys, e.g. ^https://carmatch-[a-z0-9-]+\.vercel\.app$
ALLOWED_ORIGIN_REGEX=

RATE_LIMIT_PER_HOUR=8
# Opening a car card (car details GPT call); cached per car for 7 days
DETAILS_RATE_LIMIT_PER_HOUR=40
# Public proxies in front of the app, counted from the right after private hops (Render: client + Cloudflare = 2)
TRUSTED_PROXY_HOPS=2
